[Unit]
Description=Sunlit personal website private preview
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=sunlit
Group=sunlit
WorkingDirectory=/opt/sunlit/current
EnvironmentFile=/etc/sunlit.env
ExecStart=/opt/sunlit/runtime/node-v24.16.0-linux-x64/bin/node node_modules/vinext/dist/cli.js start --hostname 127.0.0.1 --port 5183
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/sunlit/data
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
